---
// src/pages/vet-qa.astro

const fullName = "علیرضا محمّدی جعفری";
const role = "دامپزشک و مشاور ایمنی غذایی";
const phoneDisplay = "۰۹۱۲۴۹۱۷۸۲۲";
const phoneRaw = "09124917822";
const telLink = "tel:+989124917822";
const email = "amojdvm@iran.ir";
const mailLink = `mailto:${email}`;
const siteUrl = "https://vet.hsc-co.ir";
// ✅ Web3Forms - بدون محدودیت ۵۰ پیام
const formEndpoint = "https://api.web3forms.com/submit";
const web3formsKey = "0d967179-7470-4968-b994-eff822bcf23d";
const currentYear = new Date().getFullYear();

const pageData = {
  title: "پرسش و پاسخ دامپزشکی | مشاوره آنلاین و تلفنی رایگان",
  description: "پرسش و پاسخ دامپزشکی. مشاوره آنلاین و تلفنی رایگان با دکتر جعفری دامپزشک در ورامین. پاسخ به سوالات شما درباره حیوانات خانگی.",
  keywords: "پرسش و پاسخ دامپزشکی, مشاوره دامپزشکی, دامپزشک آنلاین, مشاوره رایگان پرنده, سوالات دامپزشکی, مشاور عروس هلندی",
  canonical: `${siteUrl}/vet-qa`,
  ogImage: `${siteUrl}/og/vet-qa.jpg`,
  heroBadge: "❓ پرسش و پاسخ دامپزشکی",
  heroTitle: "پرسش و پاسخ دامپزشکی",
};

// FAQ — یک منبع واحد برای نمایش و Schema
const faqs = [
  {
    q: "آیا موی گربه باعث نازایی می‌شود؟",
    a: "خیر، موی گربه به خودی خود باعث نازایی نمی‌شود. تنها بیماری توکسوپلاسموز که از طریق مدفوع گربه منتقل می‌شود، در دوران بارداری خطرناک است. با رعایت بهداشت، خطر بسیار کم است.",
  },
  {
    q: "چه غذایی به گربه بدهم؟",
    a: "بهترین غذا برای گربه، غذای خشک و مرطوب مخصوص گربه با کیفیت بالا است. غذای انسانی مانند مرغ پخته، ماهی بدون استخوان و سبزیجات مجاز نیز می‌تواند به عنوان مکمل استفاده شود.",
  },
  {
    q: "چرا گربه من دستشویی نمی‌کند؟",
    a: "دلایل مختلفی می‌تواند داشته باشد: استرس، تغییر محیط، بیماری (مانند عفونت ادراری یا سنگ کلیه)، یا مشکل در جعبه خاک. در صورت تداوم، به دامپزشک مراجعه کنید.",
  },
  {
    q: "چند بار در روز باید به سگ غذا داد؟",
    a: "توله سگ‌ها ۳-۴ بار در روز، سگ‌های بالغ ۲ بار در روز، و سگ‌های مسن ۲ بار در روز با غذای مناسب سنشان.",
  },
  {
    q: "آیا عروس هلندی می‌تواند حمام کند؟",
    a: "بله، عروس هلندی می‌تواند حمام کند. بهترین روش، اسپری آب ولرم با اسپری مخصوص یا ظرف آب کم‌عمق است. هرگز از شامپوی انسانی استفاده نکنید.",
  },
  {
    q: "هزینه عقیم‌سازی گربه ماده چقدر است؟",
    a: "هزینه عقیم‌سازی گربه ماده بسته به وزن، سن و شرایط متفاوت است. برای اطلاع دقیق با شماره ۰۹۱۲۴۹۱۷۸۲۲ تماس بگیرید.",
  },
  {
    q: "چگونه بفهمم گربه من تب دارد؟",
    a: "علائم تب در گربه: بی‌حالی، بی‌اشتهایی، گوش‌های گرم، تنفس سریع، لرزش. برای تشخیص دقیق، از دامپزشک کمک بگیرید.",
  },
  {
    q: "آیا می‌توانم خرگوش را حمام کنم؟",
    a: "بهتر است خرگوش را حمام نکنید. در صورت لزوم، با دستمال مرطوب تمیز کنید. حمام کردن می‌تواند باعث استرس و سرماخوردگی خرگوش شود.",
  },
];

// JSON-LD: FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// JSON-LD: VeterinaryCare (LocalBusiness)
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "VeterinaryCare",
  name: `دکتر ${fullName}`,
  description: pageData.description,
  url: pageData.canonical,
  telephone: `+98${phoneRaw.slice(1)}`,
  email,
  image: pageData.ogImage,
  priceRange: "$$",
  areaServed: ["ورامین", "پیشوا", "قرچک", "پاکدشت"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "ورامین",
    addressRegion: "تهران",
    addressCountry: "IR",
  },
};

// JSON-LD: Person
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: fullName,
  jobTitle: role,
  telephone: `+98${phoneRaw.slice(1)}`,
  email,
  url: pageData.canonical,
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageData.title}</title>
    <meta name="description" content={pageData.description} />
    <meta name="keywords" content={pageData.keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageData.canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageData.title} />
    <meta property="og:description" content={pageData.description} />
    <meta property="og:url" content={pageData.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={`دکتر ${fullName}`} />
    <meta property="og:image" content={pageData.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageData.title} />
    <meta name="twitter:description" content={pageData.description} />
    <meta name="twitter:image" content={pageData.ogImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#0a4a6c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --primary: #0a4a6c;
        --primary-light: #e8f4fb;
        --primary-mid: #1a6a94;
        --primary-dark: #06344d;
        --secondary: #2ecc71;
        --secondary-dark: #27ae60;
        --gold: #f1c40f;
        --gold-bg: #fef9e7;
        --text: #132533;
        --text-mid: #3a5a6a;
        --text-muted: #6b7c8c;
        --bg: #f0f7fb;
        --surface: #ffffff;
        --shadow: 0 8px 32px rgba(10, 74, 108, 0.10);
        --shadow-hover: 0 16px 48px rgba(10, 74, 108, 0.16);
        --r-card: 24px;
        --r-pill: 50px;
        --transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Vazirmatn', 'Tahoma', sans-serif;
        background: var(--bg);
        color: var(--text);
        direction: rtl;
        line-height: 1.75;
        padding: 20px;
        background-image:
          radial-gradient(circle at 10% 20%, rgba(10,74,108,0.04) 0%, transparent 40%),
          radial-gradient(circle at 90% 80%, rgba(46,204,113,0.04) 0%, transparent 40%);
      }
      .page { max-width: 920px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }
      .card {
        background: var(--surface);
        border-radius: var(--r-card);
        box-shadow: var(--shadow);
        padding: 32px 40px;
        border: 1px solid rgba(10, 74, 108, 0.06);
        animation: fadeUp 0.55s ease both;
        transition: var(--transition);
      }
      .card:hover { box-shadow: var(--shadow-hover); }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 20px 28px;
      }
      .logo-area { display: flex; align-items: center; gap: 14px; }
      .logo-icon {
        width: 52px; height: 52px;
        background: linear-gradient(145deg, var(--primary) 0%, var(--primary-mid) 100%);
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; color: #fff; flex-shrink: 0;
        box-shadow: 0 6px 18px rgba(10,74,108,0.25);
      }
      .logo-text { font-size: 19px; font-weight: 800; color: var(--primary); letter-spacing: -0.3px; }
      .contact-badge { display: flex; align-items: center; gap: 18px; font-size: 14px; color: var(--text-mid); }
      .contact-badge a {
        color: var(--primary); text-decoration: none; font-weight: 700;
        transition: var(--transition); padding: 6px 12px; border-radius: 10px;
      }
      .contact-badge a:hover { background: var(--primary-light); color: var(--primary-dark); }
      .hero {
        text-align: center; position: relative; overflow: hidden;
        padding: 48px 40px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fcff 100%);
      }
      .hero .badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--gold-bg); color: #9a7b0a;
        border: 1px solid #f5e6a3;
        padding: 7px 22px; border-radius: 40px;
        font-size: 13px; font-weight: 700; margin-bottom: 20px;
        box-shadow: 0 2px 10px rgba(241,196,15,0.15);
      }
      .hero h1 {
        font-size: 34px; font-weight: 900; color: var(--text);
        line-height: 1.4; margin-bottom: 12px;
        position: relative; z-index: 1;
      }
      .hero h1 .highlight { color: var(--primary); position: relative; }
      .hero h1 .highlight::after {
        content: ''; position: absolute; bottom: 3px; right: 0; left: 0;
        height: 5px;
        background: linear-gradient(90deg, var(--gold), #f39c12);
        border-radius: 3px; opacity: 0.85;
      }
      .hero p { font-size: 17px; color: var(--text-mid); max-width: 650px; margin: 0 auto; line-height: 2; }
      .cta-group {
        display: flex; justify-content: center; flex-wrap: wrap; gap: 14px;
        position: relative; z-index: 1; margin-top: 20px;
      }
      .btn-primary {
        background: linear-gradient(145deg, var(--primary) 0%, var(--primary-mid) 100%);
        color: #fff; padding: 15px 38px; border: none; border-radius: var(--r-pill);
        font-size: 17px; font-weight: 700; font-family: inherit; cursor: pointer;
        transition: var(--transition); text-decoration: none;
        display: inline-flex; align-items: center; gap: 8px;
        box-shadow: 0 8px 24px rgba(10,74,108,.28);
      }
      .btn-primary:hover {
        background: linear-gradient(145deg, var(--primary-dark) 0%, var(--primary) 100%);
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(10,74,108,.38);
      }
      .btn-secondary {
        background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-dark) 100%);
        color: #fff; padding: 15px 38px; border: none; border-radius: var(--r-pill);
        font-size: 17px; font-weight: 700; font-family: inherit; cursor: pointer;
        transition: var(--transition); text-decoration: none;
        display: inline-flex; align-items: center; gap: 8px;
        box-shadow: 0 8px 24px rgba(46,204,113,.28);
      }
      .btn-secondary:hover {
        background: linear-gradient(145deg, #219a52 0%, var(--secondary-dark) 100%);
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(46,204,113,.38);
      }
      .section-label {
        font-size: 12px; font-weight: 700; color: var(--text-muted);
        letter-spacing: 0.6px; text-transform: uppercase; margin-bottom: 16px;
        display: flex; align-items: center; gap: 12px;
      }
      .section-label::after {
        content: ''; flex: 1; height: 1px;
        background: linear-gradient(90deg, var(--primary-light), transparent);
      }
      .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
      .step-box {
        background: white; border-radius: 16px; padding: 20px 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        text-align: center; border: 1px solid var(--primary-light);
      }
      .step-box .num {
        background: var(--primary); color: white;
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 10px auto; font-weight: 700; font-size: 16px;
      }
      .step-box h4 { font-size: 15px; color: var(--text); margin-bottom: 4px; }
      .step-box p { font-size: 13px; color: var(--text-mid); line-height: 1.6; margin: 0; }

      /* FAQ accordion */
      .faq-item {
        background: var(--bg);
        border-radius: 12px;
        margin-bottom: 12px;
        border: 1px solid rgba(10, 74, 108, 0.06);
        overflow: hidden;
        transition: var(--transition);
      }
      .faq-item[open] { border-color: rgba(10,74,108,0.18); box-shadow: 0 4px 16px rgba(10,74,108,0.08); }
      .faq-item summary {
        padding: 16px 20px;
        cursor: pointer;
        font-weight: 700;
        color: var(--primary);
        font-size: 14.5px;
        list-style: none;
        position: relative;
        padding-left: 44px;
      }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after {
        content: '+';
        position: absolute;
        left: 18px; top: 50%;
        transform: translateY(-50%);
        font-size: 20px; font-weight: 400;
        color: var(--primary-mid);
        transition: var(--transition);
      }
      .faq-item[open] summary::after { content: '−'; }
      .faq-item .answer {
        padding: 0 20px 16px 20px;
        font-size: 14px;
        color: var(--text-mid);
        line-height: 1.8;
      }

      .footer {
        text-align: center; font-size: 13.5px; color: var(--text-muted);
        border-top: 1px solid var(--primary-light);
        padding-top: 24px; margin-top: 4px;
      }
      .footer a { color: var(--primary); text-decoration: none; font-weight: 600; }
      .footer .socials {
        display: flex; justify-content: center; gap: 12px;
        margin-bottom: 14px; flex-wrap: wrap;
      }
      .footer .socials a {
        font-size: 13.5px; padding: 7px 16px; border-radius: 24px;
        background: var(--primary-light); color: var(--primary);
        transition: var(--transition); font-weight: 600;
      }
      .footer .socials a:hover {
        background: var(--primary); color: #fff; transform: translateY(-2px);
      }
      .fab-call {
        position: fixed; bottom: 28px; left: 28px;
        width: 60px; height: 60px;
        background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-dark) 100%);
        color: #fff; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 26px;
        box-shadow: 0 8px 28px rgba(46,204,113,0.4);
        text-decoration: none; z-index: 100;
        transition: var(--transition);
        animation: pulse 2.5s infinite;
      }
      .fab-call:hover { transform: scale(1.1); box-shadow: 0 12px 36px rgba(46,204,113,0.5); }
      @keyframes pulse {
        0%, 100% { box-shadow: 0 8px 28px rgba(46,204,113,0.4); }
        50% { box-shadow: 0 8px 28px rgba(46,204,113,0.4), 0 0 0 14px rgba(46,204,113,0.15); }
      }
      .form-group { margin-bottom: 16px; }
      .form-group label {
        display: block; font-size: 13px; font-weight: 600;
        color: rgba(255,255,255,0.9); margin-bottom: 6px;
      }
      .form-group input, .form-group select, .form-group textarea {
        width: 100%; padding: 14px 18px; border: none; border-radius: 14px;
        font-size: 15px; font-family: inherit;
        background: rgba(255,255,255,0.95); color: var(--text);
        transition: var(--transition);
      }
      .form-group input:focus, .form-group textarea:focus {
        outline: none; background: #fff;
        box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
      }
      .form-group textarea { resize: vertical; min-height: 90px; }
      .btn-submit {
        width: 100%; padding: 16px;
        background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-dark) 100%);
        color: #fff; border: none; border-radius: var(--r-pill);
        font-size: 17px; font-weight: 700; font-family: inherit; cursor: pointer;
        transition: var(--transition); margin-top: 8px;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        box-shadow: 0 6px 20px rgba(46,204,113,0.3);
      }
      .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(46,204,113,.4); }
      .btn-submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
      .form-status {
        display: none; margin-top: 16px; padding: 14px 18px;
        border-radius: 14px; font-size: 14.5px; font-weight: 500;
        text-align: center; background: rgba(255,255,255,0.15); color: #fff;
      }
      .form-status.success { display: block; background: rgba(46,204,113,0.3); color: #d5f5e3; }
      .form-status.error { display: block; background: rgba(231,76,60,0.3); color: #fadbd8; }

      @media (max-width: 700px) {
        body { padding: 14px; }
        .card { padding: 20px 16px; }
        .hero { padding: 28px 16px; }
        .hero h1 { font-size: 24px; }
        .grid-3 { grid-template-columns: 1fr; }
        .header { flex-direction: column; text-align: center; }
        .logo-area { justify-content: center; }
        .contact-badge { justify-content: center; flex-wrap: wrap; }
        .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
        .fab-call { bottom: 20px; left: 20px; width: 56px; height: 56px; font-size: 22px; }
      }
      @media (max-width: 450px) {
        .hero h1 { font-size: 20px; }
        .logo-text { font-size: 16px; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- HEADER -->
      <header class="card header">
        <div class="logo-area">
          <div class="logo-icon" aria-hidden="true">🐾</div>
          <span class="logo-text">{fullName}</span>
        </div>
        <div class="contact-badge">
          <span>📞 <a href={telLink} aria-label="تماس با دکتر">{phoneDisplay}</a></span>
          <span>✉️ <a href={mailLink} aria-label="ارسال ایمیل">{email}</a></span>
        </div>
      </header>

      <!-- HERO -->
      <section class="card hero">
        <span class="badge">{pageData.heroBadge}</span>
        <h1>
          <span class="highlight">{pageData.heroTitle}</span><br />
          مشاوره آنلاین و تلفنی رایگان
        </h1>
        <p>
          دکتر جعفری پاسخگوی سوالات شما درباره <strong>حیوانات خانگی، پرندگان و دام</strong> است.
          مشاوره رایگان و تخصصی در اسرع وقت.
        </p>
        <div class="cta-group">
          <a href={telLink} class="btn-primary">📞 مشاوره تلفنی</a>
          <a href="#consult" class="btn-secondary">📋 ارسال سوال</a>
        </div>
      </section>

      <!-- سوالات متداول -->
      <section class="card">
        <div class="section-label">❓ سوالات متداول کاربران</div>
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="answer">{f.a}</div>
          </details>
        ))}
      </section>

      <!-- راه‌های ارتباطی -->
      <section class="card">
        <div class="section-label">📞 راه‌های ارتباط با ما</div>
        <div class="grid-3">
          <div class="step-box">
            <div class="num">۱</div>
            <h4>تماس تلفنی</h4>
            <p>با شماره <strong>{phoneDisplay}</strong> تماس بگیرید</p>
          </div>
          <div class="step-box">
            <div class="num">۲</div>
            <h4>ارسال پیام</h4>
            <p>از طریق فرم زیر سوال خود را ارسال کنید</p>
          </div>
          <div class="step-box">
            <div class="num">۳</div>
            <h4>شبکه‌های اجتماعی</h4>
            <p>تلگرام، اینستاگرام، بله، روبیکا</p>
          </div>
        </div>
      </section>

      <!-- فرم -->
      <section class="card" id="consult" style="background:linear-gradient(160deg, var(--primary) 0%, var(--primary-dark) 100%); color:#fff;">
        <h2 style="font-size:22px; font-weight:800; margin:0 0 6px 0;">📋 ارسال سوال دامپزشکی</h2>
        <p style="font-size:14.5px; opacity:0.88; margin-bottom:22px;">سوال خود را بپرسید تا در اسرع وقت پاسخ دهید.</p>
        <form id="consult-form" action={formEndpoint} method="POST" novalidate>
          <!-- ✅ فیلدهای مخفی Web3Forms -->
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="سوال جدید دامپزشکی از سایت" />
          <input type="hidden" name="from_name" value="سایت دکتر جعفری" />
          <input type="hidden" name="botcheck" value="" />

          <div class="form-group">
            <label for="f-name">نام و نام خانوادگی</label>
            <input id="f-name" type="text" name="name" placeholder="نام خود را وارد کنید" required />
          </div>
          <div class="form-group">
            <label for="f-phone">شماره تماس</label>
            <input id="f-phone" type="tel" name="phone" placeholder="۰۹۱۲۳۴۵۶۷۸۹"
                   pattern="^0?9\d{9}$" inputmode="numeric" required />
          </div>
          <div class="form-group">
            <label for="f-city">شهر شما</label>
            <select id="f-city" name="city" required>
              <option value="">انتخاب کنید...</option>
              <option value="ورامین">ورامین</option>
              <option value="پیشوا">پیشوا</option>
              <option value="قرچک">قرچک</option>
              <option value="پاکدشت">پاکدشت</option>
              <option value="سایر">سایر شهرها</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-animal">نوع حیوان</label>
            <select id="f-animal" name="animal_type" required>
              <option value="">انتخاب کنید...</option>
              <option value="سگ">سگ</option>
              <option value="گربه">گربه</option>
              <option value="پرنده">پرنده</option>
              <option value="خرگوش">خرگوش</option>
              <option value="همستر">همستر</option>
              <option value="دام">دام (گاو، گوسفند، بز)</option>
              <option value="سایر">سایر</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-message">سوال شما</label>
            <textarea id="f-message" name="message" placeholder="سوال خود را بنویسید..." required></textarea>
          </div>
          <button type="submit" class="btn-submit">🚀 ارسال سوال</button>
        </form>
        <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
      </section>

      <!-- FOOTER -->
      <footer class="card footer">
        <div class="socials">
          <a href="https://t.me/AlirezainsuranceR" target="_blank" rel="noopener">تلگرام</a>
          <a href="https://ble.ir/bime_saman_mohamadi" target="_blank" rel="noopener">بله</a>
          <a href="https://www.instagram.com/alireza.insurance/" target="_blank" rel="noopener">اینستاگرام</a>
          <a href="https://rubika.ir/Alirezainsurance" target="_blank" rel="noopener">روبیکا</a>
        </div>
        <p>📞 <a href={telLink}>{phoneDisplay}</a> &nbsp;|&nbsp; ✉️ <a href={mailLink}>{email}</a></p>
        <p style="margin-top:6px; font-size:13px;">پرسش و پاسخ دامپزشکی | مشاوره آنلاین و تلفنی رایگان</p>
        <p style="margin-top:8px; font-size:12.5px; opacity:0.7;">© {currentYear} دکتر {fullName} — تمامی حقوق محفوظ است</p>
      </footer>
    </div>

    <!-- Floating Call Button -->
    <a href={telLink} class="fab-call" aria-label="تماس فوری با دکتر">📞</a>

    <script>
      const form = document.getElementById('consult-form');
      const statusDiv = document.getElementById('form-status');
      const btn = document.querySelector('.btn-submit');

      // نرمال‌سازی ارقام فارسی/عربی به لاتین
      function normalizeDigits(s) {
        return s
          .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0))
          .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660));
      }

      const phoneInput = document.getElementById('f-phone');
      phoneInput.addEventListener('input', (e) => {
        e.target.value = normalizeDigits(e.target.value).replace(/[^\d]/g, '');
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        // اعتبارسنجی سمت کلاینت
        const phone = normalizeDigits(phoneInput.value).trim();
        if (!/^0?9\d{9}$/.test(phone)) {
          statusDiv.className = 'form-status error';
          statusDiv.textContent = '❌ لطفاً یک شماره موبایل معتبر (مثل ۰۹۱۲۳۴۵۶۷۸۹) وارد کنید.';
          phoneInput.focus();
          return;
        }

        const originalText = btn.innerHTML;
        btn.innerHTML = '⏳ در حال ارسال...';
        btn.disabled = true;
        statusDiv.className = 'form-status';
        statusDiv.textContent = '';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
          });

          // Web3Forms پاسخ JSON برمی‌گرداند
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            statusDiv.className = 'form-status success';
            statusDiv.textContent = '✅ سوال شما با موفقیت ارسال شد! به‌زودی پاسخ داده می‌شود.';
            btn.innerHTML = '✅ ارسال شد!';
            form.reset();
            setTimeout(() => {
              btn.innerHTML = originalText;
              btn.disabled = false;
            }, 4000);
          } else {
            throw new Error(data.message || 'خطا در ارسال');
          }
        } catch {
          statusDiv.className = 'form-status error';
          statusDiv.textContent = '❌ خطا در ارسال. لطفاً دوباره تلاش کنید یا مستقیماً تماس بگیرید.';
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>